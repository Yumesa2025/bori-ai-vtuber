# 이 파일을 저장소 루트에 .env로 복사한 뒤 값을 채운다. .env는 저장소에 커밋되지 않는다.
#
# 보리 서버(apps/server)가 시작할 때 루트 .env를 읽는다(apps/server/src/load-env.ts).
# - 이미 설정된 환경변수가 이긴다. .env는 비어 있는 자리만 채운다.
# - 파일이 없으면 그냥 넘어간다. 다른 파일을 쓰려면 셸에서 BORI_ENV_FILE=<경로>를 준다(.env 안에 적으면 소용없다).
# - .env를 읽는 것은 서버뿐이다. tools/obs 스크립트와 관리자 Electron 창은 셸 환경변수만 본다.
#
# API 키는 관리자 앱 화면에서 입력하는 것을 권장한다.
# 화면으로 입력한 키는 AES-256-GCM으로 암호화되어 data/ 아래에 저장된다.
# 아래 환경변수(.env 포함) 키는 저장된 키가 없을 때만 쓰고, data/에 저장하지 않는다.

# --- LLM ---
# 응답 생성과 장기 기억 임베딩에 사용한다. 관리자 화면에서 업체를 Anthropic으로 바꿔도 이 키 자리 하나를 쓴다.
OPENAI_API_KEY=

# --- TTS ---
# OpenAI TTS는 OPENAI_API_KEY를 그대로 사용한다.
# ElevenLabs 어댑터는 구현되어 있으나 실 API로 검증하지 않았다.
ELEVENLABS_API_KEY=

# --- 서버 ---
# Node API 포트. 기본값 4310
BORI_SERVER_PORT=

# 설정과 기억이 들어가는 디렉터리. 기본값은 저장소의 data/
# 실제 방송 데이터를 건드리지 않고 서버를 띄워 볼 때 다른 경로를 지정한다.
BORI_DATA_DIR=

# API를 부를 수 있는 Origin을 더한다(쉼표 구분, 예: http://127.0.0.1:5000).
# 기본값은 방송 화면(4173·4174)·1:1 화면(4175·4176)·관리자 렌더러(5174)의 127.0.0.1·localhost 주소다.
# 서버는 127.0.0.1에만 열리고 Host가 루프백이 아니면 거부하므로 다른 기기에서는 여기 적어도 열 수 없다.
BORI_ALLOWED_ORIGINS=

# 관리자 Electron 앱이 로드할 렌더러 주소. 기본값 http://127.0.0.1:5174 (셸 환경변수로 준다)
BORI_ADMIN_URL=

# --- 엔드포인트 바꿔치기 (선택) ---
# 프록시나 OpenAI 호환 엔드포인트로 돌릴 때 쓴다.
# 답변 생성, 임베딩, TTS가 모두 이 주소를 따른다. 기본값 https://api.openai.com/v1
BORI_OPENAI_BASE_URL=

# 기본값 https://api.elevenlabs.io/v1
BORI_ELEVENLABS_BASE_URL=

# --- 방송 시스템 (docs/broadcast/implementation-plan.md) ---
# 방송 진행기(W4)가 서버에서 읽는다.
# 이터널리턴 Open API 키. 없으면 메타 갱신(/api/er/refresh)과 !전적 조회를 하지 않는다.
ER_API_KEY=

# 메타 집계 규모. 상위 랭커 수(기본 100)와 랭커마다 볼 최근 랭크 경기 수(기본 3).
# 개인 키는 초당 1회라 기본 규모는 몇 분 걸린다. 확인용으로 줄일 때만 바꾼다.
BORI_ER_RANKERS=
BORI_ER_GAMES_PER_RANKER=

# 치지직 개발자 센터 애플리케이션의 Client ID·Secret. 없으면 치지직 연결을 쓰지 않는다.
# Redirect URL은 http://localhost:4310/api/chzzk/callback 으로 등록한다(서버 포트를 바꾸면 그 포트로).
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=

# OBS WebSocket 서버 주소와 비밀번호(OBS 도구 > WebSocket 서버 설정). 주소 기본값 ws://127.0.0.1:4455
# 비밀번호가 있을 때만 서버가 OBS에 자동 연결한다. 없으면 장면 전환 없이 진행한다.
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=

# 테스트용. 가짜 서버로 돌릴 때만 쓴다. 비워 두면 공식 주소를 쓴다.
# 치지직 Open API 기본값 https://openapi.chzzk.naver.com, 이터널리턴 Open API 기본값 https://open-api.bser.io
BORI_CHZZK_BASE_URL=
BORI_ER_BASE_URL=

# --- OBS 연동 도구 (tools/obs, 셸 환경변수로 준다) ---
# OBS WebSocket 주소. 기본값 ws://127.0.0.1:4455
OBS_URL=

# OBS 도구 > WebSocket 서버 설정에서 확인한 비밀번호.
# 코드나 설정 파일에 직접 적지 않는다.
OBS_PASSWORD=

# OBS에 생성할 씬 이름
BORI_OBS_SCENE=

# OBS에 생성할 브라우저 소스 이름
BORI_OBS_SOURCE=

# 브라우저 소스가 열 방송 화면 주소.
# OBS에서는 입력창을 숨기기 위해 ?input=0을 붙인다.
BORI_URL=

# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 저장소에 커밋되지 않는다.
#
# API 키는 관리자 앱 화면에서 입력하는 것을 권장한다.
# 화면으로 입력한 키는 AES-256-GCM으로 암호화되어 data/ 아래에 저장된다.
# 아래 환경변수는 저장된 키가 없을 때만 사용된다.

# --- LLM ---
# 응답 생성과 장기 기억 임베딩에 사용한다.
OPENAI_API_KEY=

# Anthropic 어댑터용. 구현되어 있으나 실 API 환경에서 검증되지 않았다.
ANTHROPIC_API_KEY=

# --- TTS ---
# OpenAI TTS는 OPENAI_API_KEY를 그대로 사용한다.
# ElevenLabs 어댑터는 구현되어 있으나 사용하지 않는다.
ELEVENLABS_API_KEY=

# --- 서버 ---
# Node API 포트. 기본값 4310
BORI_SERVER_PORT=

# 관리자 Electron 앱이 로드할 렌더러 주소. 기본값 http://127.0.0.1:5174
BORI_ADMIN_URL=

# 설정과 기억이 들어가는 디렉터리. 기본값은 저장소의 data/
# 실제 방송 데이터를 건드리지 않고 서버를 띄워 볼 때 다른 경로를 지정한다.
BORI_DATA_DIR=

# --- 엔드포인트 바꿔치기 (선택) ---
# 프록시나 OpenAI 호환 엔드포인트로 돌릴 때 쓴다.
# 답변 생성, 임베딩, TTS가 모두 이 주소를 따른다. 기본값 https://api.openai.com/v1
BORI_OPENAI_BASE_URL=

# 기본값 https://api.elevenlabs.io/v1
BORI_ELEVENLABS_BASE_URL=

# --- OBS 연동 (tools/obs) ---
# OBS WebSocket 주소. 기본값 ws://127.0.0.1:4455
OBS_URL=

# OBS 도구 > WebSocket 서버 설정에서 확인한 비밀번호.
# 코드나 설정 파일에 직접 적지 않는다.
OBS_PASSWORD=

# OBS에 생성할 씬 이름
BORI_OBS_SCENE=

# OBS에 생성할 브라우저 소스 이름
BORI_OBS_SOURCE=

# 브라우저 소스가 열 방송 화면 주소.
# OBS에서는 입력창을 숨기기 위해 ?input=0을 붙인다.
BORI_URL=

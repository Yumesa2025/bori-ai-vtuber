{
  "name": "bori-ai-vtuber",
  "private": true,
  "version": "0.1.0",
  "description": "Local AI VTuber broadcast screen and admin app for Bori",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:broadcast\" \"npm:dev:admin\" \"npm:dev:companion\"",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:broadcast": "npm --workspace apps/broadcast run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:companion": "npm --workspace apps/companion run dev",
    "build": "npm run build:admin && npm run build:broadcast && npm run build:companion",
    "build:broadcast": "npm --workspace apps/broadcast run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:companion": "npm --workspace apps/companion run build",
    "test": "node tools/test/run.mjs",
    "test:soak": "node tools/test/soak.mjs",
    "obs:setup": "node tools/obs/setup-show.mjs",
    "test:unit": "node --import tsx --test --test-timeout=30000 \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:broadcast && npm run typecheck:admin && npm run typecheck:live2d && npm run typecheck:llm && npm run typecheck:memory && npm run typecheck:character && npm run typecheck:companion && npm run typecheck:er",
    "typecheck:shared": "npm --workspace packages/shared run typecheck",
    "typecheck:server": "npm --workspace apps/server run typecheck",
    "typecheck:broadcast": "npm --workspace apps/broadcast run typecheck",
    "typecheck:admin": "npm --workspace apps/admin run typecheck"
    ,"typecheck:live2d": "npm --workspace packages/live2d run typecheck"
    ,"typecheck:llm": "npm --workspace packages/llm run typecheck"
    ,"typecheck:memory": "npm --workspace packages/memory run typecheck"
    ,"typecheck:character": "npm --workspace packages/character run typecheck"
    ,"typecheck:companion": "npm --workspace apps/companion run typecheck"
    ,"typecheck:er": "npm --workspace packages/er run typecheck"
    ,"eval": "node --import tsx tools/eval/run.ts"
    ,"eval:static": "node --import tsx tools/eval/run.ts --only static"
    ,"eval:model": "node --import tsx tools/eval/run.ts --only model"
    ,"eval:compare": "node --import tsx tools/eval/compare.ts"
    ,"eval:test": "node --import tsx --test --test-timeout=30000 \"tools/eval/test/*.test.ts\""
    ,"eval:typecheck": "tsc -p tools/eval/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "socket.io": "2.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.3"
  }
}
